add table inet egressd
add set inet egressd blocked_ranges { type ipv4_addr; flags interval; auto-merge; }
add set inet egressd blocked_exempt { type ipv4_addr; flags interval; auto-merge; }
add map inet egressd pre_vmap { type ifname : verdict; }
add map inet egressd in_vmap { type ifname : verdict; }
add chain inet egressd conn_reject
flush chain inet egressd conn_reject
add rule inet egressd conn_reject meta l4proto tcp reject with tcp reset
add rule inet egressd conn_reject reject with icmpx admin-prohibited
add chain inet egressd sb_7
add chain inet egressd sbin_7
add set inet egressd allow_7 { type ipv4_addr; flags timeout; }
add set inet egressd allow_cidr_7 { type ipv4_addr; flags interval; auto-merge; }
add element inet egressd pre_vmap { "veth-h7" : jump sb_7 }
add element inet egressd in_vmap { "veth-h7" : jump sbin_7 }
delete element inet egressd pre_vmap { "veth-h7" }
delete element inet egressd in_vmap { "veth-h7" }
flush chain inet egressd sb_7
delete chain inet egressd sb_7
flush chain inet egressd sbin_7
delete chain inet egressd sbin_7
delete set inet egressd allow_7
delete set inet egressd allow_cidr_7
