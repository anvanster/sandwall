add table inet egressd
add set inet egressd blocked_ranges { type ipv4_addr; flags interval; auto-merge; }
add set inet egressd blocked_exempt { type ipv4_addr; flags interval; auto-merge; }
add map inet egressd pre_vmap { type ifname : verdict; }
add map inet egressd in_vmap { type ifname : verdict; }
add map inet egressd nat_vmap { type ifname : verdict; }
add set inet egressd direct_cidrs { type ipv4_addr; flags interval; auto-merge; }
add chain inet egressd conn_reject
flush chain inet egressd conn_reject
add rule inet egressd conn_reject meta l4proto tcp reject with tcp reset
add rule inet egressd conn_reject reject with icmpx admin-prohibited
add chain inet egressd sb_7
flush chain inet egressd sb_7
add chain inet egressd sbin_7
flush chain inet egressd sbin_7
add chain inet egressd sbnat_7
flush chain inet egressd sbnat_7
add set inet egressd allow_7 { type ipv4_addr; flags timeout; }
add set inet egressd direct_7 { type ipv4_addr; flags timeout; }
flush set inet egressd allow_7
flush set inet egressd direct_7
add set inet egressd allow_cidr_7 { type ipv4_addr; flags interval; auto-merge; }
flush set inet egressd allow_cidr_7
add element inet egressd allow_cidr_7 { 203.0.113.0/24 }
add rule inet egressd sb_7 ct state established,related accept
add rule inet egressd sb_7 ip daddr 10.200.7.1 meta l4proto { tcp, udp } th dport 53 accept
add rule inet egressd sb_7 meta l4proto { tcp, udp } th dport { 53, 853 } counter log group 1 prefix "egressd:7:dns_bypass " drop
add rule inet egressd sb_7 meta nfproto ipv6 counter log group 1 prefix "egressd:7:ipv6 " drop
add rule inet egressd sb_7 ip daddr 10.200.0.0/16 counter log group 1 prefix "egressd:7:blocked_range " drop
add rule inet egressd sb_7 ip daddr @blocked_ranges ip daddr != @blocked_exempt counter log group 1 prefix "egressd:7:blocked_range " drop
add rule inet egressd sb_7 ct state new limit rate over 20/second burst 20 packets counter log group 1 prefix "egressd:7:rate_limit " drop
add rule inet egressd sb_7 ct state new ct count over 64 counter log group 1 prefix "egressd:7:conn_limit " jump conn_reject
add rule inet egressd sb_7 ip daddr @allow_7 ip daddr != @allow_cidr_7 udp dport 443 counter log group 1 prefix "egressd:7:quic_blocked " jump conn_reject
add rule inet egressd sb_7 ip daddr @allow_7 accept
add rule inet egressd sb_7 ip daddr @allow_cidr_7 accept
add rule inet egressd sb_7 counter log group 1 prefix "egressd:7:not_allowed " drop
add rule inet egressd sbin_7 ct state established,related accept
add rule inet egressd sbin_7 ip daddr 10.200.7.1 meta l4proto { tcp, udp } th dport 53 accept
add rule inet egressd sbin_7 ip daddr 10.200.7.1 tcp dport 15001 ct status dnat accept
add rule inet egressd sbin_7 counter log group 1 prefix "egressd:7:host_access " drop
add rule inet egressd sbnat_7 tcp dport { 80, 443 } fib daddr type != local redirect to :15001
add element inet egressd pre_vmap { "veth-h7" : jump sb_7 }
add element inet egressd in_vmap { "veth-h7" : jump sbin_7 }
add element inet egressd nat_vmap { "veth-h7" : jump sbnat_7 }
