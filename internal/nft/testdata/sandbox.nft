add table inet sandwall
add set inet sandwall blocked_ranges { type ipv4_addr; flags interval; auto-merge; }
add set inet sandwall blocked_exempt { type ipv4_addr; flags interval; auto-merge; }
add map inet sandwall pre_vmap { type ifname : verdict; }
add map inet sandwall in_vmap { type ifname : verdict; }
add map inet sandwall nat_vmap { type ifname : verdict; }
add set inet sandwall direct_cidrs { type ipv4_addr; flags interval; auto-merge; }
add set inet sandwall quarantined { type ifname; }
add chain inet sandwall conn_reject
flush chain inet sandwall conn_reject
add rule inet sandwall conn_reject meta l4proto tcp reject with tcp reset
add rule inet sandwall conn_reject reject with icmpx admin-prohibited
add chain inet sandwall sb_7
flush chain inet sandwall sb_7
add chain inet sandwall sbin_7
flush chain inet sandwall sbin_7
add chain inet sandwall sbnat_7
flush chain inet sandwall sbnat_7
add set inet sandwall allow_7 { type ipv4_addr; flags timeout; }
add set inet sandwall direct_7 { type ipv4_addr; flags timeout; }
flush set inet sandwall allow_7
add element inet sandwall allow_7 { 140.82.112.3 timeout 60s, 151.101.0.223 timeout 300s }
flush set inet sandwall direct_7
add set inet sandwall allow_cidr_7 { type ipv4_addr; flags interval; auto-merge; }
flush set inet sandwall allow_cidr_7
add element inet sandwall allow_cidr_7 { 203.0.113.0/24, 198.51.100.7/32 }
add element inet sandwall quarantined { "veth-h7" }
delete element inet sandwall quarantined { "veth-h7" }
add rule inet sandwall sb_7 ct state established,related accept
add rule inet sandwall sb_7 ip daddr 10.200.7.1 meta l4proto { tcp, udp } th dport 53 accept
add rule inet sandwall sb_7 meta l4proto { tcp, udp } th dport { 53, 853 } counter log group 1 prefix "sandwall:7:dns_bypass " drop
add rule inet sandwall sb_7 meta nfproto ipv6 counter log group 1 prefix "sandwall:7:ipv6 " drop
add rule inet sandwall sb_7 ip daddr 10.200.0.0/16 counter log group 1 prefix "sandwall:7:blocked_range " drop
add rule inet sandwall sb_7 ip daddr @blocked_ranges ip daddr != @blocked_exempt counter log group 1 prefix "sandwall:7:blocked_range " drop
add rule inet sandwall sb_7 ct state new limit rate over 20/second burst 20 packets counter log group 1 prefix "sandwall:7:rate_limit " drop
add rule inet sandwall sb_7 ct state new ct count over 64 counter log group 1 prefix "sandwall:7:conn_limit " jump conn_reject
add rule inet sandwall sb_7 ip daddr @allow_7 accept
add rule inet sandwall sb_7 ip daddr @allow_cidr_7 accept
add rule inet sandwall sb_7 counter log group 1 prefix "sandwall:7:not_allowed " drop
add rule inet sandwall sbin_7 ct state established,related accept
add rule inet sandwall sbin_7 ip daddr 10.200.7.1 meta l4proto { tcp, udp } th dport 53 accept
add rule inet sandwall sbin_7 counter log group 1 prefix "sandwall:7:host_access " drop
add element inet sandwall pre_vmap { "veth-h7" : jump sb_7 }
add element inet sandwall in_vmap { "veth-h7" : jump sbin_7 }
add element inet sandwall nat_vmap { "veth-h7" : jump sbnat_7 }
